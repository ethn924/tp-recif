{
  "name": "le-recif-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:init": "tsx scripts/init-db.ts",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/api.test.ts",
    "etape": "vitest run --dir tests/etapes",
    "test:all": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
